{
  "name": "@societyos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "bootstrap:admin": "node dist/cli/bootstrap-admin.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config test/jest.config.json --runInBand",
    "test:e2e": "jest --config test/jest-e2e.config.json --runInBand"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
