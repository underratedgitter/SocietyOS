// SocietyOS — Prisma schema (Implementation Blueprint v1.0, Section 4)
// UUID PKs, TIMESTAMPTZ (UTC), every society-owned row carries society_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum MembershipRole {
  PLATFORM_ADMIN
  SOCIETY_ADMIN
  RESIDENT
  GUARD
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
  PENDING_APPROVAL
}

enum FlatRelationship {
  OWNER
  TENANT
  FAMILY
}

enum VisitorCategory {
  RELATIVE
  FRIEND
  DELIVERY
  CAB
  MAINTENANCE
  OTHER
}

enum PassStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REVOKED
  EXPIRED
  EXHAUSTED
}

enum CredentialType {
  PIN
  QR
}

enum AccessPointType {
  BOOM_BARRIER
  SLIDING_GATE
  DOOR_LOCK
}

enum DeviceStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum CommandStatus {
  ISSUED
  ACKNOWLEDGED
  EXECUTED
  FAILED
  EXPIRED
}

enum GateState {
  CLOSED
  OPENING
  OPEN
  CLOSING
  STOPPED
  FAULT
  UNKNOWN
}

enum GateCommandType {
  OPEN
  CLOSE
  STOP
}

enum AccessDecision {
  AUTHORIZED
  DENIED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum DeviceEventType {
  COMMAND_RECEIVED
  ACK
  STATE_CHANGED
  SENSOR
  HEARTBEAT
  TAMPER
  FAULT
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------- Identity ----------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  phone           String?   @unique
  passwordHash       String
  isPlatformAdmin    Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  memberships    SocietyMembership[]
  flatMemberships ResidentFlatMembership[]
  sessions       Session[]
  notifications  Notification[]
  hostedPasses   VisitorPass[] @relation("VisitorPassHost")
  announcements   Announcement[]
  createdTickets MaintenanceTicket[] @relation("TicketAuthor")
  amenityBookings AmenityBooking[]   @relation("AmenityBooker")
  paidInvoices    MaintenanceInvoice[] @relation("InvoicePayer")
  biometricTemplates BiometricTemplate[]
  pushTokens     PushDeviceToken[]
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  userAgent        String?
  expiresAt        DateTime @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Tenancy ----------

model Society {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships SocietyMembership[]
  buildings   Building[]
  accessPoints AccessPoint[]
  devices     Device[]
  passes      VisitorPass[]
  visitors    Visitor[]
  accessEvents AccessEvent[]
  announcements Announcement[]
  maintenanceTickets MaintenanceTicket[]
  amenityBookings AmenityBooking[]
  maintenanceInvoices MaintenanceInvoice[]
  biometricTemplates BiometricTemplate[]
}

model SocietyMembership {
  id        String           @id @default(uuid()) @db.Uuid
  societyId String           @db.Uuid
  userId    String           @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([societyId, userId])
  @@index([userId])
}

// ---------- Residential ----------

model Building {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flats   Flat[]

  @@index([societyId])
}

model Flat {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @db.Uuid
  flatNumber String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  residents   ResidentFlatMembership[]
  passes      VisitorPass[]
  maintenanceTickets MaintenanceTicket[]
  amenityBookings AmenityBooking[]
  maintenanceInvoices MaintenanceInvoice[]

  @@unique([buildingId, flatNumber])
}

model ResidentFlatMembership {
  id           String          @id @default(uuid()) @db.Uuid
  flatId       String          @db.Uuid
  userId       String          @db.Uuid
  relationship FlatRelationship
  endedAt      DateTime?       @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flatId, userId])
  @@index([userId])
}

// ---------- Visitors ----------

model Visitor {
  id        String          @id @default(uuid()) @db.Uuid
  societyId String          @db.Uuid
  name      String
  phone     String?
  category  VisitorCategory
  createdAt DateTime        @default(now()) @db.Timestamptz(6)

  society Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  passes  VisitorPass[]

  @@index([societyId])
}

model VisitorPass {
  id          String          @id @default(uuid()) @db.Uuid
  societyId   String          @db.Uuid
  flatId      String          @db.Uuid
  hostUserId  String          @db.Uuid
  visitorId   String          @db.Uuid
  status      PassStatus      @default(DRAFT)
  category    VisitorCategory
  validFrom   DateTime        @db.Timestamptz(6)
  validUntil  DateTime        @db.Timestamptz(6)
  maxUses     Int             @default(1)
  usedCount   Int             @default(0)
  revokedAt   DateTime?       @db.Timestamptz(6)
  revokedBy   String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  society     Society                    @relation(fields: [societyId], references: [id])
  flat        Flat                       @relation(fields: [flatId], references: [id])
  visitor     Visitor                    @relation(fields: [visitorId], references: [id])
  host        User                       @relation("VisitorPassHost", fields: [hostUserId], references: [id])
  credentials VisitorPassCredential[]
  accessPoints VisitorPassAccessPoint[]
  uses        VisitorPassUse[]
  approvals   VisitorApproval[]
  accessEvents AccessEvent[]

  @@index([societyId, status])
  @@index([flatId])
}

model VisitorPassCredential {
  id             String         @id @default(uuid()) @db.Uuid
  passId         String         @db.Uuid
  type           CredentialType
  credentialHash String         @unique
  keyId          String
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  pass VisitorPass @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@unique([passId, type])
  @@index([credentialHash])
}

model VisitorPassAccessPoint {
  id            String @id @default(uuid()) @db.Uuid
  passId        String @db.Uuid
  accessPointId String @db.Uuid

  pass        VisitorPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  accessPoint AccessPoint @relation(fields: [accessPointId], references: [id])

  @@unique([passId, accessPointId])
}

model VisitorApproval {
  id           String           @id @default(uuid()) @db.Uuid
  passId       String           @db.Uuid
  decidedById  String?          @db.Uuid
  decision     ApprovalDecision
  reason       String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  pass VisitorPass @relation(fields: [passId], references: [id], onDelete: Cascade)
}

model VisitorPassUse {
  id            String   @id @default(uuid()) @db.Uuid
  passId        String   @db.Uuid
  redemptionId  String   @unique
  deviceId      String?  @db.Uuid
  accessPointId String   @db.Uuid
  usedAt        DateTime @default(now()) @db.Timestamptz(6)

  pass VisitorPass @relation(fields: [passId], references: [id])

  @@index([passId])
}

// ---------- Devices ----------

model AccessPoint {
  id        String          @id @default(uuid()) @db.Uuid
  societyId String          @db.Uuid
  name      String
  type      AccessPointType
  location  String?
  createdAt DateTime        @default(now()) @db.Timestamptz(6)

  society    Society                    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  devices    DeviceAccessPoint[]
  passes     VisitorPassAccessPoint[]
  accessEvents AccessEvent[]
  gateCommands GateCommand[]

  @@index([societyId])
}

model Device {
  id         String       @id @default(uuid()) @db.Uuid
  societyId  String       @db.Uuid
  deviceUid  String       @unique
  name       String
  status     DeviceStatus @default(ACTIVE)
  firmware   String?
  lastSeenAt DateTime?    @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)

  society    Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  credentials DeviceCredential[]
  accessPoints DeviceAccessPoint[]
  commands   GateCommand[]
  events     DeviceEvent[]
  healthLogs DeviceHealthLog[]

  @@index([societyId])
}

model DeviceCredential {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @db.Uuid
  tokenHash        String    @unique
  commandSecretEnc String?
  keyId            String
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model DeviceAccessPoint {
  id            String @id @default(uuid()) @db.Uuid
  deviceId      String @db.Uuid
  accessPointId String @db.Uuid

  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  accessPoint AccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)

  @@unique([deviceId, accessPointId])
}

model GateCommand {
  id            String          @id @default(uuid()) @db.Uuid
  deviceId      String          @db.Uuid
  accessPointId String          @db.Uuid
  type          GateCommandType
  nonce         String
  status        CommandStatus   @default(ISSUED)
  issuedAt      DateTime        @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime        @db.Timestamptz(6)
  ackAt         DateTime?       @db.Timestamptz(6)
  executedAt    DateTime?       @db.Timestamptz(6)
  gateStateAtExec GateState?
  signedPayload   Json?

  device      Device      @relation(fields: [deviceId], references: [id])
  accessPoint AccessPoint @relation(fields: [accessPointId], references: [id])

  @@index([deviceId, issuedAt])
  @@index([status, expiresAt])
}

model DeviceEvent {
  id            String          @id @default(uuid()) @db.Uuid
  deviceId      String          @db.Uuid
  accessPointId String?         @db.Uuid
  type          DeviceEventType
  sequence      Int?
  payload       Json
  occurredAt    DateTime        @default(now()) @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, occurredAt])
}

// ---------- Security ----------

model AccessEvent {
  id            String         @id @default(uuid()) @db.Uuid
  societyId     String         @db.Uuid
  accessPointId String?        @db.Uuid
  deviceId      String?        @db.Uuid
  passId        String?        @db.Uuid
  decision      AccessDecision
  reasonCode    String
  credentialType CredentialType?
  source        String         @default("DEVICE")
  requestId     String?
  meta          Json?
  requestedAt   DateTime       @default(now()) @db.Timestamptz(6)

  society     Society      @relation(fields: [societyId], references: [id])
  accessPoint AccessPoint? @relation(fields: [accessPointId], references: [id])
  pass        VisitorPass? @relation(fields: [passId], references: [id])

  @@index([societyId, requestedAt])
  @@index([accessPointId, requestedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  societyId   String?  @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([societyId, createdAt])
}

model SecurityAlert {
  id        String    @id @default(uuid()) @db.Uuid
  societyId String?   @db.Uuid
  severity  String
  type      String
  detail    Json?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)

  @@index([societyId, createdAt])
}

model DeviceHealthLog {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  online     Boolean
  uptimeS    Int?
  rssi       Int?
  meta       Json?
  recordedAt DateTime @default(now()) @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
}

// ---------- Notifications (transactional outbox) ----------

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  societyId String?            @db.Uuid
  userId    String?            @db.Uuid
  channel   NotificationChannel
  template  String
  payload   Json
  status      NotificationStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  nextAttemptAt DateTime?        @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  sentAt      DateTime?          @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([status, nextAttemptAt, createdAt])
}

// ---------- Idempotency ----------

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  endpoint     String
  responseBody Json
  requestHash  String?
  expiresAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([expiresAt])
}

// ---------- Stage 6 Community Life ----------

enum AnnouncementCategory {
  GENERAL
  EMERGENCY
  MAINTENANCE
  EVENT
}

enum TicketCategory {
  PLUMBING
  ELECTRICAL
  LIFT
  COMMON_AREA
  CARPENTRY
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Announcement {
  id        String               @id @default(uuid()) @db.Uuid
  societyId String               @map("society_id") @db.Uuid
  society   Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  AnnouncementCategory @default(GENERAL)
  pinned    Boolean              @default(false)
  authorId  String               @map("author_id") @db.Uuid
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([societyId, pinned, createdAt])
  @@map("announcements")
}

model MaintenanceTicket {
  id            String         @id @default(uuid()) @db.Uuid
  societyId     String         @map("society_id") @db.Uuid
  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flatId        String         @map("flat_id") @db.Uuid
  flat          Flat           @relation(fields: [flatId], references: [id], onDelete: Cascade)
  createdById   String         @map("created_by_id") @db.Uuid
  createdBy     User           @relation("TicketAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  category      TicketCategory
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  title         String
  description   String
  assignedStaff String?        @map("assigned_staff")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([societyId, status, createdAt])
  @@index([flatId])
  @@map("maintenance_tickets")
}

model AmenityBooking {
  id          String        @id @default(uuid()) @db.Uuid
  societyId   String        @map("society_id") @db.Uuid
  society     Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  amenityName String        @map("amenity_name")
  flatId      String        @map("flat_id") @db.Uuid
  flat        Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  bookedById  String        @map("booked_by_id") @db.Uuid
  bookedBy    User          @relation("AmenityBooker", fields: [bookedById], references: [id], onDelete: Cascade)
  slotStart   DateTime      @map("slot_start") @db.Timestamptz(6)
  slotEnd     DateTime      @map("slot_end") @db.Timestamptz(6)
  guestCount  Int           @default(1) @map("guest_count")
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([societyId, amenityName, slotStart])
  @@index([flatId])
  @@map("amenity_bookings")
}

model MaintenanceInvoice {
  id               String        @id @default(uuid()) @db.Uuid
  societyId        String        @map("society_id") @db.Uuid
  society          Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flatId           String        @map("flat_id") @db.Uuid
  flat             Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  amount           Float
  dueDate          DateTime      @map("due_date") @db.Timestamptz(6)
  status           InvoiceStatus @default(PENDING)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  paidById         String?       @map("paid_by_id") @db.Uuid
  paidBy           User?         @relation("InvoicePayer", fields: [paidById], references: [id], onDelete: SetNull)
  paymentReference String?       @map("payment_reference")
  gatewayOrderId   String?       @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  paymentGateway   String?       @map("payment_gateway")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([societyId, status, dueDate])
  @@index([flatId])
  @@index([gatewayOrderId])
  @@map("maintenance_invoices")
}

model BiometricTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  societyId         String   @map("society_id") @db.Uuid
  society           Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String   // 'FINGERPRINT' | 'FACE'
  templateHash      String   @unique @map("template_hash")
  encryptedTemplate String?  @map("encrypted_template")
  algorithm         String
  consentGivenAt    DateTime @map("consent_given_at") @db.Timestamptz(6)
  lawfulBasis       String   @default("DPDP_2023_SECTION_6_EXPLICIT_CONSENT") @map("lawful_basis")
  consentText       String?  @map("consent_text")
  enrolledBy        String   @map("enrolled_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([societyId, userId])
  @@index([templateHash])
  @@map("biometric_templates")
}

model PushDeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("expo") // "expo" | "web" | "ios" | "android"
  deviceName String?  @map("device_name")
  endpoint   String?  // for Web Push
  p256dh     String?  // for Web Push
  auth       String?  // for Web Push
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("push_device_tokens")
}

