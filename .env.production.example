# Copy to .env.production and replace every value before deploying.
# Generate secrets with: openssl rand -base64 48

POSTGRES_USER=societyos
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=societyos
# The same password must appear inside this URL.
DATABASE_URL=postgresql://societyos:replace-with-a-long-random-password@postgres:5432/societyos

REDIS_URL=redis://redis:6379
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=societyos-api
MQTT_PASSWORD=replace-with-a-broker-password

# Public origin, including scheme. HTTPS is required when COOKIE_SECURE=true.
WEB_URL=https://society.example.com
APP_BASE_URL=https://society.example.com
COOKIE_SECURE=true
CORS_ORIGINS=https://society.example.com

# Must stay stable: rotating these invalidates sessions or device secrets.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_HMAC_KEY=replace-with-at-least-32-random-characters
CREDENTIAL_HMAC_KEY_ID=v1
# Optional: exactly 32 bytes, base64 encoded. Derived from CREDENTIAL_HMAC_KEY when omitted.
DEVICE_SECRET_ENC_KEY=

ENABLE_SWAGGER=false
RATE_LIMIT_ENABLED=true
# Optional transactional notification webhook.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
